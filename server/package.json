{
  "name": "@chaperone/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "node --env-file-if-exists=../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "CHAPERONE_MODE=offline tsx src/index.ts",
    "redteam": "tsx --env-file-if-exists=../.env src/redteam/cli.ts",
    "hijack": "tsx --env-file-if-exists=../.env src/redteam/hijack.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
