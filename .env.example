# ── PayPal (sandbox) ─────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# How the agent's wallet pays without a redirect on every purchase:
#   vault = buyer approves PayPal ONCE (the mandate), then purchases use the vault token
#   card  = PayPal sandbox test card through Orders v2 (no approval step)
PAYPAL_PAYMENT_MODE=vault
# Optional: webhook ID from the dashboard, enables signature verification
PAYPAL_WEBHOOK_ID=

# ── AI (Gemini) ──────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUDITOR_MODEL=gemini-2.5-flash

# ── Channel3 (product data) ──────────────────────────────────────
CHANNEL3_API_KEY=

# ── Server ───────────────────────────────────────────────────────
PORT=8787
PUBLIC_URL=http://localhost:8787
# offline = no keys needed: seeded catalog, simulated PayPal + scripted AI
CHAPERONE_MODE=live
